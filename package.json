{
  "name": "game-hub",
  "version": "1.0.0",
  "description": "Game Hub - Multiplayer party games for phones and a shared screen",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:stackingroyale": "esbuild public/stackingroyale/js/engine.js --bundle --format=iife --global-name=StackingRoyale --target=es2018 --outfile=public/stackingroyale/js/engine.bundle.js",
    "test:stackingroyale": "node scripts/test-stackingroyale-engine.js",
    "itest:stackingroyale": "node scripts/itest-stackingroyale.js",
    "sim": "node scripts/sim-players.js",
    "gen:herdmind": "node scripts/gen-herdmind-questions.js",
    "test:herdmind": "node scripts/test-herdmind.js",
    "itest:herdmind": "node scripts/itest-herdmind.js",
    "itest:catclash": "node scripts/itest-catclash.js",
    "gen:rankfive": "node scripts/gen-rankfive-words.js",
    "itest:rankfive": "node scripts/itest-rankfive.js",
    "test:bombbrawl": "node scripts/test-bombbrawl-engine.js",
    "test:bombbrawl-bot": "node scripts/test-bombbrawl-bot.js",
    "itest:bombbrawl": "node scripts/itest-bombbrawl.js",
    "gen:camo": "node scripts/gen-camo-topics.js",
    "itest:camo": "node scripts/itest-camo.js"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "lucide": "1.45.0",
    "nanoid": "^3.3.7",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.5",
    "tetris-fumen": "1.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "socket.io-client": "^4.8.3"
  }
}
